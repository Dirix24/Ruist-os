#!/bin/bash
# Instala Brave desde su repositorio oficial y lo deja como navegador principal.
# Se ejecuta durante la compilación de la ISO (necesita red en ese momento).
set -e

KEYRING=/usr/share/keyrings/brave-browser-archive-keyring.gpg

curl -fsSL -o "$KEYRING" \
    https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg

echo "deb [signed-by=$KEYRING arch=amd64] https://brave-browser-apt-release.s3.brave.com/ stable main" \
    > /etc/apt/sources.list.d/brave-browser-release.list

apt-get update
apt-get install -y --no-install-recommends brave-browser

# Navegador por defecto del sistema
update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/bin/brave-browser 200
update-alternatives --set x-www-browser /usr/bin/brave-browser
update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser /usr/bin/brave-browser 200
update-alternatives --set gnome-www-browser /usr/bin/brave-browser
