{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/ruist/logo.txt",
    "color": {
      "1": "38;2;200;208;220"
    },
    "padding": {
      "right": 4
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "title": "38;2;0;110;255",
      "keys": "38;2;0;110;255",
      "separator": "38;2;120;130;150"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "locale"
  ]
}
