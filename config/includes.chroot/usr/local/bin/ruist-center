#!/bin/sh
# Ruist Center - panel de control de Ruist OS (equivalente a MX Tools)

while true; do
    OPCION=$(zenity --list --title="Ruist Center" --width=420 --height=500 \
        --text="¿Qué quieres hacer?" --hide-header \
        --column="id" --column="Acción" --hide-column=1 \
        actualizar "Actualizar el sistema" \
        software   "Tienda de programas" \
        repositorios "Repositorios Git" \
        drivers    "Drivers y componentes (NVIDIA, Wi-Fi...)" \
        impresoras "Impresoras" \
        rendimiento "Modo de rendimiento" \
        restaurar  "Puntos de restauración (Timeshift)" \
        limpiar    "Limpiar el sistema" \
        info       "Información del sistema" \
        sesiones   "Instalar o cambiar de escritorio" \
        escritorio "Personalizar XFCE" \
        perfiles   "Perfiles de aplicaciones" \
        hardware   "Inventario de hardware" \
        kernel     "Kernel estable y recuperación" 2>/dev/null) || exit 0

    case "$OPCION" in
        actualizar)
            xfce4-terminal --hold -e "pkexec /usr/local/bin/ruist-update" ;;
        software)
            gnome-software ;;
        repositorios)
            ruist-git ;;
        drivers)
            ruist-drivers ;;
        impresoras)
            system-config-printer ;;
        rendimiento)
            MODO=$(zenity --list --title="Modo de rendimiento" --width=525 --height=325 \
                --text="TLP adapta el consumo al equipo. Elige un perfil o consulta el diagnóstico." --hide-header \
                --column="id" --column="Modo" --hide-column=1 \
                rendimiento "Perfil de corriente" \
                equilibrado "Automático (corriente o batería)" \
                ahorro      "Ahorro de energía" \
                estado      "Ver diagnóstico del equipo" 2>/dev/null) || continue
            if [ "$MODO" = estado ]; then
                ruist-perf estado 2>&1 | zenity --text-info --title="Rendimiento" \
                    --width=700 --height=500 --filename=/dev/stdin
            else
                ruist-perf "$MODO" || zenity --error --text="No se pudo aplicar el perfil de energía."
            fi ;;
        restaurar)
            timeshift-launcher ;;
        limpiar)
            xfce4-terminal --hold -e "pkexec /usr/local/bin/ruist-maintenance cleanup" ;;
        info)
            zenity --text-info --title="Información del sistema" --width=520 --height=420 \
                --filename=/dev/stdin <<EOF 2>/dev/null
$(ruist-info)
EOF
            ;;
        hardware)
            INFORME=$(ruist-detect 2>&1)
            zenity --text-info --title="Ruist Detect" --width=760 --height=560 \
                --filename=/dev/stdin <<EOF 2>/dev/null
$INFORME
EOF
            ;;
        sesiones)
            ruist-sessions ;;
        escritorio)
            ruist-desktop ;;
        perfiles)
            ruist-profile ;;
        kernel)
            ruist-kernel ;;
    esac
done
