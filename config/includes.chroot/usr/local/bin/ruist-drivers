#!/bin/sh
# ruist-drivers - gestor de drivers y firmware (equivalente a los de MX Linux)
# Sin argumentos abre la interfaz gráfica.
# Las instalaciones se confirman en APT. Como root admite solo acciones y paquetes
# de la lista permitida; no ejecuta nombres de paquete como comandos.

set -f

if [ "$(id -u)" -eq 0 ] && [ -n "${1:-}" ]; then
    set -eu
    ACCION="$1"
    shift
    case "$ACCION" in
        nvidia)
            [ "$#" -eq 1 ] || { echo "Uso: ruist-drivers nvidia PAQUETE" >&2; exit 2; }
            case "$1" in
                nvidia-driver|nvidia-[a-z0-9.+-]*-driver) ;;
                *) echo "El paquete no parece un controlador NVIDIA recomendado: $1" >&2; exit 2 ;;
            esac
            apt-get update
            apt-get install linux-headers-amd64 dkms "$1"
            echo
            echo "Listo. Reinicia el equipo para usar el driver NVIDIA." ;;
        quitar-nvidia)
            [ "$#" -eq 0 ] || { echo "Uso: ruist-drivers quitar-nvidia" >&2; exit 2; }
            apt-get purge '^nvidia-.*' 'libnvidia-.*' 'xserver-xorg-video-nvidia.*'
            apt-get autoremove
            echo
            echo "Driver NVIDIA eliminado. Reinicia para volver al driver libre (nouveau)." ;;
        paquetes)
            [ "$#" -gt 0 ] || { echo "Indica los paquetes de firmware o controlador." >&2; exit 2; }
            INTEL_MICROCODE=0
            AMD_MICROCODE=0
            for paquete in "$@"; do
                case "$paquete" in
                    broadcom-sta-dkms|firmware-iwlwifi|firmware-atheros|firmware-realtek|firmware-misc-nonfree|intel-microcode|amd64-microcode|firmware-amd-graphics|printer-driver-all|hplip) ;;
                    *) echo "Paquete de controlador fuera de la lista permitida: $paquete" >&2; exit 2 ;;
                esac
                [ "$paquete" = intel-microcode ] && INTEL_MICROCODE=1
                [ "$paquete" = amd64-microcode ] && AMD_MICROCODE=1
            done
            if [ "$INTEL_MICROCODE" -eq 1 ] && [ "$AMD_MICROCODE" -eq 1 ]; then
                echo "No se pueden instalar microcódigos Intel y AMD en la misma operación." >&2
                exit 2
            fi
            apt-get update
            case " $* " in
                *" broadcom-sta-dkms "*) apt-get install linux-headers-amd64 dkms "$@" ;;
                *) apt-get install "$@" ;;
            esac
            echo
            echo "Listo. Si algo no aparece todavía, reinicia el equipo." ;;
        *)
            echo "Uso: ruist-drivers [nvidia PAQUETE | quitar-nvidia | paquetes PAQUETE...]" >&2
            exit 2 ;;
    esac
    exit 0
fi

run_privileged() {
    xfce4-terminal --hold --execute pkexec /usr/local/bin/ruist-drivers "$@"
}

menu_nvidia() {
    if ! command -v nvidia-detect >/dev/null 2>&1; then
        zenity --error --text="Falta la herramienta nvidia-detect." 2>/dev/null
        return
    fi

    INFORME=$(nvidia-detect 2>&1)
    PAQUETE=$(echo "$INFORME" | grep -o 'nvidia-[a-z0-9.-]*driver' | head -1)
    ACTUAL=$(dpkg -l 2>/dev/null | awk '/^ii +nvidia-[a-z0-9.-]*driver /{print $2; exit}')

    if ! echo "$INFORME" | grep -qi 'detected nvidia'; then
        zenity --info --title="Drivers NVIDIA" --width=400 \
            --text="No se ha detectado ninguna tarjeta NVIDIA en este equipo." 2>/dev/null
        return
    fi

    TEXTO="$INFORME

Driver instalado: ${ACTUAL:-ninguno (se usa el libre, nouveau)}
Driver recomendado: ${PAQUETE:-ninguno disponible en Debian para esta tarjeta}"

    ACCION=$(zenity --list --title="Drivers NVIDIA" --width=560 --height=420 \
        --text="$TEXTO" --hide-header --column="id" --column="Acción" --hide-column=1 \
        instalar "Instalar el driver recomendado" \
        quitar   "Quitar el driver NVIDIA y volver a nouveau" 2>/dev/null) || return

    case "$ACCION" in
        instalar)
            if [ -z "$PAQUETE" ]; then
                zenity --warning --width=420 \
                    --text="Debian no ofrece un driver propietario para esta tarjeta. Se seguirá usando nouveau." 2>/dev/null
                return
            fi
            zenity --question --title="Driver NVIDIA propietario" --width=460 \
                --text="Se instalará $PAQUETE desde los repositorios APT configurados. La operación requiere Internet y puede necesitar un reinicio." 2>/dev/null || return
            run_privileged nvidia "$PAQUETE" ;;
        quitar)
            run_privileged quitar-nvidia ;;
    esac
}

menu_componentes() {
    SEL=$(zenity --list --checklist --title="Otros drivers y firmware" --width=620 --height=520 \
        --text="Marca lo que necesites (Wi-Fi, microcódigo, impresoras...)" \
        --column="" --column="id" --column="Componente" --hide-column=2 --separator=" " \
        FALSE broadcom-sta-dkms    "Wi-Fi Broadcom (driver propietario)" \
        FALSE firmware-iwlwifi     "Wi-Fi/Bluetooth Intel" \
        FALSE firmware-atheros     "Wi-Fi Atheros" \
        FALSE firmware-realtek     "Red y Wi-Fi Realtek" \
        FALSE firmware-misc-nonfree "Firmware variado (Wi-Fi, vídeo y otros)" \
        FALSE intel-microcode      "Microcódigo de procesadores Intel" \
        FALSE amd64-microcode      "Microcódigo de procesadores AMD" \
        FALSE firmware-amd-graphics "Firmware de gráficos AMD" \
        FALSE printer-driver-all   "Impresoras (drivers generales)" \
        FALSE hplip                "Impresoras y escáneres HP" 2>/dev/null) || return
    if [ -n "$SEL" ]; then
        set -- $SEL
        run_privileged paquetes "$@"
    fi
}

while true; do
    OPCION=$(zenity --list --title="Drivers y componentes" --width=440 --height=300 \
        --text="¿Qué quieres configurar?" --hide-header \
        --column="id" --column="Opción" --hide-column=1 \
        nvidia      "Tarjeta gráfica NVIDIA" \
        componentes "Otros drivers y firmware" 2>/dev/null) || exit 0

    case "$OPCION" in
        nvidia)      menu_nvidia ;;
        componentes) menu_componentes ;;
    esac
done
