#!/bin/sh
# Leave manual wallpaper choices untouched after the initial setup.
set -eu

marker="${XDG_CONFIG_HOME:-$HOME/.config}/ruist/first-login-done"
[ ! -f "$marker" ] || exit 0
for attempt in 1 2 3; do
    if ruist-wallpaper neon; then
        mkdir -p "$(dirname "$marker")"
        : > "$marker"
        exit 0
    fi
    sleep 1
done
exit 1
