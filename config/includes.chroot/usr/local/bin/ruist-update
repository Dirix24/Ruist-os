#!/bin/sh

set -e

echo "=========================="
echo "      Ruist OS Update"
echo "=========================="
echo

echo "Actualizando información de paquetes..."
apt-get update

echo
echo "Actualizando Ruist OS..."
echo "Revisa la lista de cambios y confirma la actualización cuando apt-get lo solicite."
apt-get full-upgrade

echo
echo "Ruist OS está actualizado."
