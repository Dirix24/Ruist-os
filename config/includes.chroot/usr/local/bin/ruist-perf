#!/bin/sh
# Use TLP so that the active profile has a single owner.
set -eu

case "${1:-estado}" in
    estado)
        printf 'Memoria y swap\n'
        free -h
        printf '\nZRAM\n'
        /usr/sbin/zramctl
        printf '\nDiscos y capacidad de descarte (TRIM)\n'
        lsblk -d -o NAME,SIZE,ROTA,TRAN,DISC-MAX,SCHED
        printf '\nCarga y tiempo encendido\n'
        uptime
        printf '\nEstado de energía\n'
        exec tlp-stat -s
        ;;
    rendimiento) profile=ac ;;
    equilibrado) profile=start ;;
    ahorro) profile=bat ;;
    *) echo "Uso: ruist-perf [rendimiento|equilibrado|ahorro|estado]" >&2; exit 2 ;;
esac

if [ "$(id -u)" -eq 0 ]; then
    exec /usr/sbin/tlp "$profile"
fi
exec pkexec /usr/sbin/tlp "$profile"
