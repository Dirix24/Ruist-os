#!/bin/sh
# Open supported native XFCE settings dialogs; preferences persist in the user session.

set -eu

while :; do
    OPTION=$(zenity --list --title="Ruist Desktop" --width=440 --height=300 \
        --text="Configura el escritorio XFCE" --hide-header \
        --column="id" --column="Ajuste" --hide-column=1 \
        oscuro "Aplicar tema oscuro" \
        claro "Aplicar tema claro" \
        fondo "Fondo e iconos del escritorio" \
        apariencia "Tema e iconos" \
        efectos "Efectos de ventanas" \
        pantalla "Pantallas y resolución" 2>/dev/null) || exit 0

    case "$OPTION" in
        oscuro|claro)
            theme=Arc-Dark
            icons=Papirus-Dark
            dark=true
            tint=0.0
            opacity=0.12
            if [ "$OPTION" = claro ]; then
                theme=Arc
                icons=Papirus
                dark=false
                tint=0.95
                opacity=0.82
            fi
            xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$theme"
            xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "$icons"
            xfconf-query -c xfwm4 -p /general/theme -n -t string -s "$theme"
            xfconf-query -c xfce4-panel -p /panels/dark-mode -n -t bool -s "$dark"
            panel=/panels/panel-1
            if xfconf-query -c xfce4-panel -p "$panel/position" >/dev/null 2>&1; then
                xfconf-query -c xfce4-panel -p "$panel/background-rgba" -n -a \
                    -t double -s "$tint" -t double -s "$tint" -t double -s "$tint" \
                    -t double -s "$opacity"
                xfconf-query -c xfce4-panel -p "$panel/background-style" -n -t uint -s 1
            fi
            exit 0 ;;
        fondo) exec xfdesktop-settings ;;
        apariencia) exec xfce4-appearance-settings ;;
        efectos) exec xfwm4-tweaks-settings ;;
        pantalla) exec xfce4-display-settings ;;
        *) exit 0 ;;
    esac
done
