#!/bin/sh
# Ruist Kernel: administra el metapaquete estable de Debian sin retirar kernels.
set -eu

usage() {
    echo "Uso: ruist-kernel [install|status]" >&2
}

installed_kernels() {
    dpkg-query -W -f='${binary:Package}\n' 'linux-image-[0-9]*' 2>/dev/null | sort -V || true
}

status() {
    printf 'Arquitectura: %s\nKernel activo: %s\n' "$(dpkg --print-architecture 2>/dev/null || uname -m)" "$(uname -r)"
    echo 'Kernels instalados:'
    installed_kernels | sed 's/^/  /'
    echo 'Metapaquete estable: linux-image-amd64'
    apt-cache policy linux-image-amd64 2>/dev/null | awk '/Candidate:/ {print "Candidato APT: " $2}'
}

install_stable() {
    arch=$(dpkg --print-architecture)
    case "$arch" in
        amd64|i386) ;;
        *) echo "Arquitectura no admitida por este gestor: $arch" >&2; exit 2 ;;
    esac
    candidate=$(apt-cache policy linux-image-amd64 | awk '/Candidate:/ {print $2; exit}')
    if [ -z "$candidate" ] || [ "$candidate" = '(none)' ]; then
        echo 'No hay un kernel estable de Debian disponible en los repositorios APT configurados.' >&2
        exit 1
    fi
    echo 'Se instalará o actualizará el kernel estable de Debian.'
    echo 'Los kernels instalados no se eliminarán; conserva el kernel anterior como opción de recuperación en GRUB.'
    apt-get install linux-image-amd64
}

action=${1:-}
case "$action" in
    status)
        [ "$#" -eq 1 ] || { usage; exit 2; }
        status
        ;;
    install)
        [ "$#" -eq 1 ] || { usage; exit 2; }
        if [ "$(id -u)" -ne 0 ]; then
            exec pkexec /usr/local/bin/ruist-kernel install
        fi
        install_stable
        ;;
    *)
        if [ "$#" -ne 0 ]; then usage; exit 2; fi
        current=$(uname -r)
        installed=$(installed_kernels)
        candidate=$(apt-cache policy linux-image-amd64 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
        choice=$(zenity --list --title='Ruist Kernel' --width=620 --height=420 \
            --text="Kernel activo: $current\n\nKernels instalados:\n${installed:-no detectados}\n\nCandidato Debian: ${candidate:-no disponible}\n\nSolo se administra el metapaquete estable. La instalación conserva los kernels anteriores." \
            --hide-header --column=id --column=Acción --hide-column=1 \
            status 'Actualizar información' install 'Instalar/actualizar kernel estable' 2>/dev/null) || exit 0
        case "$choice" in
            status) xfce4-terminal --hold --execute /usr/local/bin/ruist-kernel status ;;
            install) zenity --question --title='Kernel estable de Debian' \
                --text='Se instalará linux-image-amd64 desde tus repositorios configurados. Se conservará el kernel anterior. ¿Continuar?' 2>/dev/null || exit 0
                xfce4-terminal --hold --execute /usr/local/bin/ruist-kernel install ;;
        esac
        ;;
esac
