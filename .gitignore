# ========================================
# RUIST OS - ARCHIVOS GENERADOS
# ========================================

# ISO e imágenes generadas
*.iso
*.img
*.squashfs

# Live-build: directorios generados
binary/
cache/
chroot/
stage/
build/
.build/

# Estado temporal de live-build
binary.modified_timestamps
chroot.files

# Listados generados de la ISO
live-image-*.contents
live-image-*.files
live-image-*.packages

# Copias y archivos comprimidos generados
*.tar.zst
*.tar.gz
*.tar.xz

# Logs
*.log
wget-log*

# Backups locales
config-backup-*/

# Temporales
*.tmp
*~

# Python bytecode
__pycache__/
*.py[cod]
